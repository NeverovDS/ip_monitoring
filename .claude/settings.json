{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bin/rails test *)",
      "Bash(bin/rails db:test:prepare test)",
      "Bash(bin/rubocop)",
      "Bash(bin/rubocop -a)",
      "Bash(bin/brakeman --no-pager)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(gh *)",
      "Bash(*kamal *)",
      "Bash(aws *)",
      "Edit(/.githooks/**)"
    ],
    "deny": [
      "Read(/.env.deploy)",
      "Read(/config/master.key)",
      "Read(/config/credentials/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git * --no-verify*)",
      "Bash(git config *)",
      "Bash(git -c *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "attribution": { "commit": "", "pr": "", "sessionUrl": false },
  "worktree": { "baseRef": "head" },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|Grep|Glob",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_secrets.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
